{
  "name": "lumbre-commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply lumbre-commons --local",
    "db:remote": "wrangler d1 migrations apply lumbre-commons --remote"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.107.1"
  }
}
