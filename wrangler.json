{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumbre-commons",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumbre-commons",
      "database_id": "19431236-3518-48a4-a5ba-5b2e93240b5b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "lumbre-commons-artifacts"
    }
  ],
  "vars": {
    "APP_URL": "https://lumbre-commons.ia-cardenas10.workers.dev",
    "OPENAI_MODEL": "gpt-6-astra",
    "ANTHROPIC_MODEL": "",
    "AI_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 30000
  }
}
